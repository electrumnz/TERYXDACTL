<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network: to reach the Pi on the Teryx's own Wi-Fi hotspot (and over 4G, when allowed). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Teryx Remote"
        android:icon="@drawable/ic_teryx"
        android:theme="@style/TeryxTheme"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <!-- Also offered as a home app: pick it as Home and the phone boots straight into the remote. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|uiMode"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:lockTaskMode="if_whitelisted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Samsung XCover key = hardware STOP. Makes the app show up under Settings >
             Advanced features > XCover key > Control XCover key with app. -->
        <meta-data android:name="com.samsung.android.knox.intent.action.HARD_KEY_PRESS" android:value="true" />
        <receiver android:name=".XCoverKeyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.samsung.android.knox.intent.action.HARD_KEY_REPORT" />
            </intent-filter>
        </receiver>

        <!-- Only used if you make the app the phone's "device owner" with adb (full kiosk lock).
             See android/README.md. Nothing happens otherwise. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
