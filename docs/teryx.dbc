VAL_ 1793 effect 0 "none" 1 "strobe" 2 "chase" 3 "outside_only" 4 "inside_only" 5 "breathe" 6 "sos" ;
VAL_ 1808 state 0 "boot" 1 "ok" 2 "degraded" 3 "failsafe" ;
VAL_ 1808 reject_reason 0 "none" 1 "too_fast" 2 "not_stopped" 3 "speed_unknown" 4 "not_armed" 5 "interlock" 6 "actuator_fault" 7 "low_12v" 8 "dash_link" 9 "ignition_off" 10 "at_limit" 11 "not_parked" 12 "winch_remote" 13 "bad_frame" ;
