CM_ BO_ 384 "PLACEHOLDER layout. Bytes 0-2 are what the Pico reads for its speed interlocks.";
CM_ SG_ 385 batt_a "+ = draw, - = regen";
CM_ BO_ 385 "PLACEHOLDER layout.";
CM_ BO_ 386 "PLACEHOLDER layout.";
CM_ SG_ 387 fault_over_current "Motor over current";
CM_ SG_ 387 fault_over_voltage "Battery voltage too high";
CM_ SG_ 387 fault_under_voltage "Battery voltage too low";
CM_ SG_ 387 fault_motor_over_temp "Motor too hot";
CM_ SG_ 387 fault_controller_over_temp "Controller too hot";
CM_ SG_ 387 fault_hall_sensor "Motor position sensor fault";
CM_ SG_ 387 fault_throttle "Throttle fault";
CM_ SG_ 387 fault_comms "Controller comms fault";
CM_ SG_ 387 fault_battery_over_temp "Battery too hot";
CM_ SG_ 387 fault_precharge "Precharge fault";
CM_ SG_ 387 error_code "Controller ErrorCode, same number as the LED flash count (0 or 1 = no fault). Text in config/shinegle-faults.yaml";
CM_ BO_ 387 "PLACEHOLDER layout.";
CM_ BO_ 1792 "Pico stops tray, winch and actuators if this goes quiet for 500 ms.";
CM_ SG_ 1793 rear_auto "Rear pods on automatically in reverse";
CM_ BO_ 1793 "On change, plus a resend every 1 s. Brightness 0-255 (0 = off). On/off-only bars treat anything above 0 as on.";
CM_ SG_ 1794 fourwd_req "0 = 2WD, 1 = 4WD";
CM_ BO_ 1794 "On change, plus a resend every 1 s.";
CM_ SG_ 1795 tray "-1 down, 0 stop, +1 up";
CM_ SG_ 1795 winch "-1 out, 0 stop, +1 in";
CM_ SG_ 1795 winch_timed_s "Timed pull length, 0 = plain hold. Pico stops it on time by itself, capped at setting 21";
CM_ BO_ 1795 "Hold-to-run, sent at 10 Hz only while a button is held. Pico stops if it goes quiet for 300 ms.";
CM_ BO_ 1796 "On change, one key per frame. The Pico echoes it on 0x714 as an ack. Keys are in SETTINGS below. 0xF0 = save to flash, 0xF1 = reset defaults.";
CM_ BO_ 1797 "Vehicle lock command, on demand (docs/vehicle-lock.md). Digits are BCD, first digit in the high nibble of d0. PIN 4-6 digits, recovery code 8. The Pico keeps only a salted hash and answers on 0x716 straight away.";
CM_ SG_ 1798 head_low "Low beam, both sides";
CM_ SG_ 1798 head_high "High beam, both sides. Wins over low";
CM_ SG_ 1798 tail "Tail lights, 0 = automatic (on with any headlight or front bar)";
CM_ SG_ 1798 rear "Rear flood level while 0x701 rear_on is set, 0 = full";
CM_ SG_ 1798 beacon "Roof beacon brightness, 0 = off. The Pico flashes it at 3 Hz";
CM_ SG_ 1798 show "Light show, parked only";
CM_ SG_ 1798 flash "Flash mode: warning = beacon strobe, emergency = every lamp flashes (stopped). Key on, not locked. Moving: amber beacon only, at 3 Hz";
CM_ SG_ 1798 beacon_white "White side of the beacon, 0 = off. 3 Hz opposite the amber, only when stopped";
CM_ BO_ 1798 "Stock lamps, rear floods, beacon, trailer bar and the light show (docs/lights.md). On change, plus a resend every 1 s. Levels 0-255, 0 = off. The Pico keeps brake lights at full, never dims headlights or tails while moving, and only runs a show when parked.";
CM_ BO_ 1823 "Pico reboots to its bootloader when magic = 0x5445 ('TE') and parked.";
CM_ SG_ 1808 fault_bits "See FAULT_BITS";
CM_ SG_ 1808 inputs "MCP23017 B0-B7, see INPUT_BITS";
CM_ SG_ 1808 on_defaults "Pico is running on default settings, please resend";
CM_ SG_ 1808 fourwd_wait "A 2WD/4WD request is waiting for the right speed (docs/drive-changes.md)";
CM_ SG_ 1808 diff_wait "A diff lock request is waiting for the right speed";
CM_ SG_ 1808 throttle_hold "Throttle held: a shift is running from a standstill";
CM_ SG_ 1808 park_block "Park brake on: drive blocked, relay 6 open (docs/park-brake.md)";
CM_ SG_ 1808 reject_reason "Why the last request was refused";
CM_ SG_ 1808 reject_count "Goes up by one each time a request is refused";
CM_ SG_ 1808 shutdown_request "Key off: Pi should shut down";
CM_ SG_ 1808 parked "Stopped and safe for OTA updates";
CM_ SG_ 1808 sentry_hold "Key off, power kept on because the Pi asked for sentry";
CM_ SG_ 1808 sentry_flat "Sentry refused: 12V under setting 32 (until the key goes on)";
CM_ SG_ 1808 speed "Speed as the Pico sees it, 255 = unknown";
CM_ SG_ 1809 relays "See RELAY_BITS";
CM_ SG_ 1809 relays2 "Second relay board, see RELAY2_BITS (power steering on, drive lock)";
CM_ BO_ 1809 "What the outputs are actually doing (after effects and safety).";
CM_ SG_ 1810 diff_pct "From the actuator pot";
CM_ SG_ 1810 tray_pct "Estimate from run time, no pot on the tray";
CM_ SG_ 1810 diff_target "While diff_wait is set, the % it's waiting to move to";
CM_ SG_ 1811 diff_pot_raw "Raw ADS1115 reading, for calibrating keys 14/15";
CM_ SG_ 1811 winch_idle_s "Seconds since the winch last ran while armed (caps at 255)";
CM_ BO_ 1812 "Echo of each 0x704 frame once the Pico has applied it (value is what it actually used).";
CM_ SG_ 1814 tries_left "Wrong tries left before a lockout";
CM_ SG_ 1814 lockout_s "Lockout time left";
CM_ SG_ 1814 window "Change window open (PIN checked in the last 60 s)";
CM_ SG_ 1814 puk_set "A recovery code is stored";
CM_ SG_ 1814 inhibit "Drive inhibit asked for (how is TBC until the Shinegle is decoded)";
CM_ SG_ 1814 pending "Remote lock asked for, waiting until stopped 10 s or key off";
CM_ SG_ 1814 result "Result of the last 0x705";
CM_ SG_ 1814 result_count "Goes up by one per 0x705";
CM_ SG_ 1814 fails "Wrong tries in a row (kept over power cuts)";
CM_ BO_ 1814 "Vehicle lock state (docs/vehicle-lock.md). Also sent straight after every 0x705.";
CM_ SG_ 1815 show_blocked "A show was asked for but the Teryx isn't parked (key on, park brake, stopped)";
CM_ SG_ 1815 pwm_ok "PCA9685 answering";
CM_ SG_ 1815 flash_running "Beacon warning or full emergency running";
CM_ BO_ 1815 "What the PCA9685 lamps are actually doing, after every safety rule (docs/lights.md). Levels are 0-15 (top 4 bits of 0-255).";
CM_ SG_ 1816 frames_on "Speed frames going to the ECU";
CM_ SG_ 1816 heard "Something heard from the ECU lately";
CM_ SG_ 1816 torque_valid "0x260 fresh: torque and angle are real";
CM_ SG_ 1816 angle_init "ECU says the angle is still initialising";
CM_ SG_ 1816 override "ECU says the driver is turning hard";
CM_ SG_ 1816 listen "Setting 37 on: a quiet ECU is a warning";
CM_ SG_ 1816 mode_pending "Steering mode change waiting for the Teryx to stop";
CM_ SG_ 1816 bus_ok "Steering CAN board working";
CM_ SG_ 1816 torque "Driver torque, raw from the ECU (units unknown)";
CM_ SG_ 1816 angle "Steering angle from the ECU";
CM_ SG_ 1816 told_kmh "Speed told to the ECU, 255 = no frames";
CM_ SG_ 1816 ecu_status "EPS_STATUS LKA_STATE byte, 255 = never heard";
CM_ BO_ 1816 "Power steering (docs/power-steering-aqua.md). Torque, angle and ECU status are only real once the Aqua ECU has been heard (flag torque_valid).";
