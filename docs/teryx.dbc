CM_ BO_ 384 "PLACEHOLDER layout. Bytes 0-2 are what the Pico reads for its speed interlocks.";
CM_ SG_ 385 batt_a "+ = draw, - = regen";
CM_ BO_ 385 "PLACEHOLDER layout.";
CM_ BO_ 386 "PLACEHOLDER layout.";
CM_ SG_ 387 fault_over_current "Motor over current";
CM_ SG_ 387 fault_over_voltage "Battery voltage too high";
CM_ SG_ 387 fault_under_voltage "Battery voltage too low";
CM_ SG_ 387 fault_motor_over_temp "Motor too hot";
CM_ SG_ 387 fault_controller_over_temp "Controller too hot";
CM_ SG_ 387 fault_hall_sensor "Motor position sensor fault";
CM_ SG_ 387 fault_throttle "Throttle fault";
CM_ SG_ 387 fault_comms "Controller comms fault";
CM_ SG_ 387 fault_battery_over_temp "Battery too hot";
CM_ SG_ 387 fault_precharge "Precharge fault";
CM_ BO_ 387 "PLACEHOLDER layout.";
CM_ BO_ 1792 "Pico stops tray, winch and actuators if this goes quiet for 500 ms.";
CM_ SG_ 1793 rear_auto "Rear pods on automatically in reverse";
CM_ BO_ 1793 "On change, plus a resend every 1 s. Brightness 0-255 (0 = off). On/off-only bars treat anything above 0 as on.";
CM_ SG_ 1794 fourwd_req "0 = 2WD, 1 = 4WD";
CM_ BO_ 1794 "On change, plus a resend every 1 s.";
CM_ SG_ 1795 tray "-1 down, 0 stop, +1 up";
CM_ SG_ 1795 winch "-1 out, 0 stop, +1 in";
CM_ SG_ 1795 winch_timed_s "Timed pull length, 0 = plain hold. Pico stops it on time by itself, capped at setting 21";
CM_ BO_ 1795 "Hold-to-run, sent at 10 Hz only while a button is held. Pico stops if it goes quiet for 300 ms.";
CM_ BO_ 1796 "On change, one key per frame. The Pico echoes it on 0x714 as an ack. Keys are in SETTINGS below. 0xF0 = save to flash, 0xF1 = reset defaults.";
CM_ BO_ 1823 "Pico reboots to its bootloader when magic = 0x5445 ('TE') and parked.";
CM_ SG_ 1808 fault_bits "See FAULT_BITS";
CM_ SG_ 1808 inputs "MCP23017 B0-B7, see INPUT_BITS";
CM_ SG_ 1808 on_defaults "Pico is running on default settings, please resend";
CM_ SG_ 1808 reject_reason "Why the last request was refused";
CM_ SG_ 1808 reject_count "Goes up by one each time a request is refused";
CM_ SG_ 1808 shutdown_request "Key off: Pi should shut down";
CM_ SG_ 1808 parked "Stopped and safe for OTA updates";
CM_ SG_ 1808 speed "Speed as the Pico sees it, 255 = unknown";
CM_ SG_ 1809 relays "See RELAY_BITS";
CM_ BO_ 1809 "What the outputs are actually doing (after effects and safety).";
CM_ SG_ 1810 diff_pct "From the actuator pot";
CM_ SG_ 1810 tray_pct "Estimate from run time, no pot on the tray";
CM_ SG_ 1811 diff_pot_raw "Raw ADS1115 reading, for calibrating keys 14/15";
CM_ SG_ 1811 winch_idle_s "Seconds since the winch last ran while armed (caps at 255)";
CM_ BO_ 1812 "Echo of each 0x704 frame once the Pico has applied it (value is what it actually used).";
CM_ SG_ 2016 inputs "Bits as INPUT_BITS";
CM_ SG_ 2016 force_mask "Which input bits to force";
CM_ SG_ 2016 fault_inject "See BENCH_FAULTS";
CM_ SG_ 2016 aux_mv "Fake 12V reading, 0 = leave alone";
CM_ BO_ 2016 "HOST/BENCH BUILD ONLY. Lets the simulator drive the Pico's wired inputs and inject faults. The real Pico firmware ignores it.";

