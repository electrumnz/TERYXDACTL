// Plymouth boot splash: logo in the middle of a black screen with a slow pulse.
Window.SetBackgroundTopColor(0.02, 0.03, 0.03);
Window.SetBackgroundBottomColor(0.02, 0.03, 0.03);
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
t = 0;
fun refresh() {
  t++;
  logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(t / 25));
}
Plymouth.SetRefreshFunction(refresh);
